# API
SHARDRIVE_HTTP_ADDRESS=:8080
SHARDRIVE_SHUTDOWN_TIMEOUT=10s
SHARDRIVE_DB_CONNECT_TIMEOUT=10s
SHARDRIVE_DB_HEALTH_TIMEOUT=2s
SHARDRIVE_CHUNK_SIZE_BYTES=33554432
SHARDRIVE_UPLOAD_SESSION_LIFETIME=24h
SHARDRIVE_GLOBAL_UPLOAD_LIMIT=6
# Local HTTP development only. Keep true behind HTTPS in production.
SHARDRIVE_COOKIE_SECURE=false

# Fixed development user used by the current API handlers. This is separate
# from LocalProvider provisioning, so Proton-only mode can leave the local
# account user ID empty while keeping the API user configured.
SHARDRIVE_API_USER_ID=

# LocalProvider development/test settings. Set
# SHARDRIVE_LOCAL_ACCOUNT_USER_ID to provision local-1 through local-N at API
# startup. Leave it empty for Proton-only account provisioning. LocalProvider
# and Proton accounts are not mixed in the default placement pool.
SHARDRIVE_LOCAL_STORAGE_ROOT=./data/storage
SHARDRIVE_LOCAL_ACCOUNT_USER_ID=
SHARDRIVE_LOCAL_ACCOUNT_COUNT=5
SHARDRIVE_LOCAL_ACCOUNT_QUOTA_BYTES=1073741824
SHARDRIVE_LOCAL_MAX_UPLOAD_WORKERS=2
SHARDRIVE_LOCAL_MAX_DOWNLOAD_WORKERS=1
SHARDRIVE_PROTON_ADAPTER_ADDRESS=
# Optional adapter endpoint. Keep empty for LocalProvider-only mode. For the
# Compose Proton profile, set this to proton-adapter:50051.
PROTON_SDK_COMMIT=c8d03244938a6b4d107c755df8904d7d971ed1c2
# Base64 file containing the 32-byte adapter master key. Keep outside Git.
SHARDRIVE_PROTON_MASTER_KEY_FILE=../secrets/proton-master-key.b64
SHARDRIVE_PROTON_HTTP_TIMEOUT_MS=60000

# PostgreSQL development defaults. Change the password outside local development.
POSTGRES_DB=shardrive
POSTGRES_USER=shardrive
POSTGRES_PASSWORD=shardrive-dev-only
SHARDRIVE_POSTGRES_PORT=5432
SHARDRIVE_DATABASE_URL=postgres://shardrive:shardrive-dev-only@localhost:5432/shardrive?sslmode=disable
